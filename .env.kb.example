#=====================================================================#
#            LibreChat RAG SaaS — configuration tout-en-un            #
#  Copiez ce fichier vers .env puis lancez :                          #
#    docker compose -f docker-compose.kb.yml up -d --build            #
#=====================================================================#

#=============#
#   Serveur   #
#=============#
PORT=3080
DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080
NO_INDEX=true

#=====================================================#
#   Secrets — À RÉGÉNÉRER avant toute mise en ligne   #
#   https://www.librechat.ai/toolkit/creds_generator  #
#=====================================================#
CREDS_KEY=f34be427ebb29de8d88c107a71546019685ed8b241d8f2ed00c3df97ad2566f0
CREDS_IV=e2341419ec3dd3d19b13a1a87fafcbfb
JWT_SECRET=16f8c0ef4a5d391b26034086c628469d3f9f497f08163ab9b40137092f2909ef
JWT_REFRESH_SECRET=eaa5191f2914e30b9387fd84e254e4ba6fc51b4654968a9b0803b456a54b8418
MEILI_MASTER_KEY=kb_meili_master_key_change_me

#==================================================================#
#   Authentification                                               #
#   Le PREMIER compte enregistré devient automatiquement ADMIN.    #
#   Créez-le, puis passez ALLOW_REGISTRATION=false : les comptes   #
#   suivants se créent depuis l'écran admin (/kb) ou l'invitation. #
#==================================================================#
ALLOW_REGISTRATION=true
ALLOW_EMAIL_LOGIN=true
ALLOW_SOCIAL_LOGIN=false
ALLOW_UNVERIFIED_EMAIL_LOGIN=true

#=========================================================#
#   Fournisseur LLM du chat — renseignez au moins un      #
#   (le RAG utilise Ollama pour les embeddings, mais le   #
#   modèle de conversation reste à votre choix)           #
#=========================================================#
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_KEY=...

#===================================================#
#   Knowledge Base (activée par le docker compose)  #
#===================================================#
# Base pgvector (service `vectordb` du compose)
POSTGRES_DB=librechat_kb
POSTGRES_USER=kbuser
POSTGRES_PASSWORD=kbpassword

# Embeddings — Ollama par défaut (service `ollama` du compose).
# KB_EMBEDDINGS_DIM doit correspondre au modèle (768 pour nomic-embed-text).
KB_EMBEDDINGS_PROVIDER=ollama
KB_EMBEDDINGS_MODEL=nomic-embed-text
KB_EMBEDDINGS_DIM=768
# Pour un fournisseur compatible OpenAI à la place d'Ollama :
# KB_EMBEDDINGS_PROVIDER=openai
# KB_EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# KB_EMBEDDINGS_API_KEY=sk-...
# KB_EMBEDDINGS_MODEL=text-embedding-3-small
# KB_EMBEDDINGS_DIM=1536

# Découpage et ingestion
KB_CHUNK_SIZE=1000
KB_CHUNK_OVERLAP=200
KB_MAX_FILE_SIZE_MB=50
KB_WORKER_CONCURRENCY=2
KB_WORKER_POLL_MS=5000
KB_EMBEDDINGS_BATCH=32

#=============================================#
#   Email (optionnel — pour les invitations)  #
#=============================================#
# EMAIL_SERVICE=gmail
# EMAIL_USERNAME=...
# EMAIL_PASSWORD=...
# EMAIL_FROM=noreply@example.com
